<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CloudNekoCli</AssemblyName>
    <RootNamespace>CloudNeko.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\CloudNeko\NekoState.cs" Link="NekoState.cs" />
    <Compile Include="..\CloudNeko\SessionPaths.cs" Link="SessionPaths.cs" />
  </ItemGroup>

</Project>
